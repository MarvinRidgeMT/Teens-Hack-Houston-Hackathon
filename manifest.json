{
  "manifest_version": 3,
  "name": "Pickup",
  "version": "1.0.0",
  "description": "Undo the interruption, not the mistake. Saves your place when you leave your work and hands it back when you return.",
  "minimum_chrome_version": "123",
  "permissions": [
    "tabs",
    "tabGroups",
    "idle",
    "alarms",
    "notifications",
    "storage",
    "scripting",
    "contextMenus",
    "sidePanel",
    "tts"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/sw/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pickup",
    "default_popup": "src/pages/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_page": "src/pages/setup.html",
  "side_panel": { "default_path": "src/voice/panel.html" },
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/InterVariable.woff2"],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "commands": {
    "park-task": {
      "suggested_key": { "default": "Alt+P", "windows": "Alt+P", "linux": "Alt+P", "chromeos": "Alt+P", "mac": "MacCtrl+Shift+P" },
      "description": "Park this task with an optional next step"
    },
    "resume-task": {
      "suggested_key": { "default": "Alt+R", "windows": "Alt+R", "linux": "Alt+R", "chromeos": "Alt+R", "mac": "MacCtrl+Shift+R" },
      "description": "Jump back to your task"
    },
    "wrap-up": {
      "description": "Wrap up for today (Pickup shows where to start tomorrow)"
    },
    "toggle-voice": {
      "suggested_key": { "default": "Alt+V", "windows": "Alt+V", "linux": "Alt+V", "chromeos": "Alt+V", "mac": "MacCtrl+Shift+V" },
      "description": "Open the Pickup panel"
    }
  }
}
